# wxo Developer Edition
WXO_BASE_URL=http://localhost:4321/api/v1
WXO_USERNAME=
WXO_PASSWORD=
WXO_AGENT=
# 留空则使用登录用户可见的第一个 tenant
WXO_TENANT_ID=

# Streaming Endpoint 是否发送增量 typing 更新,以及发送间隔(秒)
WS_PARTIAL_UPDATES=true
WS_UPDATE_INTERVAL=0.5

# Azure Bot 的 App Registration(Single Tenant / Client Secret)
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
# 仅本地调试:允许不带 Authorization 的请求
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__ANONYMOUS_ALLOWED=true

PORT=3978
